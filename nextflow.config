/*
 * VJDB Sequence Clustering — configuration
 * All parameter defaults live here. Override them on the command line
 * (--threads 32) or in your own config file (-c my.config).
 */

manifest {
    name            = 'maltesie/vjdb-clustering'
    description     = 'Hierarchical clustering of viral genomes and incremental cluster updates'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '>=23.04.0'
}

params {
    // Mode: 'initial' (Phase 1) or 'update' (Phase 2)
    mode           = null

    // Phase 1 inputs
    input          = null      // FASTA.gz with all sequences
    block_size     = 1000000   // sequences per chunk

    // Phase 2 inputs
    new_seqs       = null      // FASTA.gz with new sequences
    existing_reps  = null      // representative FASTA.gz from Phase 1 or a previous update
    existing_csv   = null      // membership CSV from Phase 1 or a previous update
    prefix_update  = 'vjdb1_new'

    // Output and resources
    outdir         = 'results'
    threads        = 10

    // Clustering thresholds
    linclust_id    = 0.95      // MMseqs2 linclust --min-seq-id (Phase 1)
    ani            = 0.95      // vclust ANI threshold
    qcov           = 0.85      // vclust query coverage threshold

    // Tool commands (provided by the conda environment by default)
    mmseqs         = 'mmseqs'
    vclust         = 'vclust'

    // Check the outputs against the expected test results (set by the test profiles)
    check_test     = false
}

conda.enabled = true
conda.useMicromamba = true

process {
    conda  = "${projectDir}/environment.yml"
    cpus   = params.threads
    memory = '16 GB'
    time   = '4h'

    // The Python steps are single-threaded
    withName: 'HASH_DEDUP|EXTRACT_MERGE_CHUNK_REPS|MERGE_FINAL_CLUSTERS|EXTRACT_REPS_OF_REPS|PREPARE_UPDATE|FINALIZE_UPDATE|CHECK_TEST_.*' {
        cpus = 1
    }
}

profiles {
    // Small update run on the bundled test data, with automatic checks:
    //   nextflow run main.nf -profile test
    test {
        params.mode          = 'update'
        params.new_seqs      = "${projectDir}/test_data/vjdb1_test_new_sequences.fna.gz"
        params.existing_reps = "${projectDir}/test_data/vjdb1_merged_reps.fna.gz"
        params.existing_csv  = "${projectDir}/test_data/vjdb1_merged_reps.csv"
        params.outdir        = 'results_test'
        params.check_test    = true
        process.cpus         = 2
        process.memory       = '2 GB'
    }

    // Initial clustering of the synthetic full test dataset in 3 chunks, with
    // automatic checks:  nextflow run main.nf -profile test_initial
    test_initial {
        params.mode       = 'initial'
        params.input      = "${projectDir}/test_data/vjdb1_test_full_dataset.fna.gz"
        params.block_size = 300
        params.outdir     = 'results_test_initial'
        params.check_test = true
        process.cpus      = 2
        process.memory    = '2 GB'
    }

    // Use mmseqs and vclust from your PATH instead of the conda environment
    no_conda {
        conda.enabled = false
    }

    // SLURM cluster; adapt the queue to your system. Memory is sized for
    // ~1M sequences per vclust run; the Python steps keep the 16 GB default.
    slurm {
        process {
            executor = 'slurm'
            queue    = 'batch'
            withName: 'LINCLUST' {
                memory = '100 GB'
            }
            withName: 'VCLUST_CLUSTER.*' {
                memory = '200 GB'
            }
        }
    }
}
