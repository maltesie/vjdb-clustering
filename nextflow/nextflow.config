/*
 * Default configuration — override per-environment as needed.
 */

params {
    outdir   = 'results'
    threads  = 24
    ani      = 0.95
    qcov     = 0.85
    mmseqs   = 'mmseqs'
    vclust   = 'vclust.py'
}

process {
    // Default resources — adjust for your VM
    cpus   = params.threads
    memory = '16 GB'
    time   = '4h'
}

// Uncomment and adapt for your execution environment:
// profiles {
//     local {
//         process.executor = 'local'
//     }
//     slurm {
//         process.executor = 'slurm'
//         process.queue    = 'batch'
//     }
